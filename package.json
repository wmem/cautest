{
  "name": "cautest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "cautest-install": "dist/install.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json && node dist/build-info.js",
    "test": "pnpm run build && pnpm run test:types && node --test test/schema.test.js test/config.test.js test/factory.test.js test/workflow.test.js test/native.test.js test/install.test.js",
    "test:e2e": "node --test test/git-install.test.js",
    "test:types": "tsc --noEmit --strict --exactOptionalPropertyTypes --target ES2022 --module NodeNext --moduleResolution NodeNext test/types/config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/picomatch": "4.0.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.6"
  },
  "packageManager": "pnpm@11.23.0",
  "dependencies": {
    "picomatch": "4.0.7"
  }
}
